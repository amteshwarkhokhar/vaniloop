# Copy to .env and fill in. .env is gitignored. Never commit real values.

# --- LLM for audit labels, fix proposals and replays (OpenAI-compatible endpoint)
# OpenRouter: https://openrouter.ai/api/v1   (turn off prompt logging; allow only Google as provider)
# IndiaMART LiteLLM: https://litellm.indiamart.com
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=google/gemini-3-flash-preview

# --- Optional
# Stop LLM calls once this many US dollars are spent in a run (planned, see the cost-meter issue).
LLM_BUDGET_USD=15
# Set to "refresh" to ignore the disk cache in .cache/llm and call the model again.
VANILOOP_CACHE=
# Folder the dashboard reads (default: runs/ if audits exist, else tests/fixtures).
VANILOOP_DATA=
# Sarvam API key for TTS (Bulbul) in the voice demo. The Sarvam MCP logs in separately.
SARVAM_API_KEY=
