# Copy to .env and fill in. .env is gitignored. Never commit real values.

# --- LLM for audit labels, fix proposals and replays (OpenAI-compatible endpoint)
# Default: the IndiaMART LiteLLM proxy (call data stays on the company proxy). Key: your internal LiteLLM key.
# Alternative: OpenRouter https://openrouter.ai/api/v1 (turn off prompt logging; allow only Google as provider)
LLM_BASE_URL=https://imllm.intermesh.net/v1
LLM_API_KEY=
# flex/ = lower-priority tier of the same model on the proxy
LLM_MODEL=flex/google/gemini-3-flash-preview

# --- Jev (TypeSafe) judgement labels: pipeline judge, VANILOOP_JUDGE=jev
TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai/v1/systemone
# TYPESAFE_MODEL=jev-latest

# --- Optional
# Hard cap in US dollars on total spend recorded in runs/costs.jsonl. Delete or rename that file to reset.
LLM_BUDGET_USD=15
# Set to "refresh" to ignore the disk cache in .cache/llm and call the model again.
VANILOOP_CACHE=
# Folder the dashboard reads (default: runs/ if audits exist, else tests/fixtures).
VANILOOP_DATA=
